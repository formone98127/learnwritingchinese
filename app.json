{
  "expo": {
    "name": "learnwritingchinese",
    "slug": "learnwritingchinese",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "learnwritingchinese",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F0E4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "لکھائی کی ترتیب",
      "description": "دیکھیں، لکھیں، ایک ایک لکیر سے روایتی چینی سیکھیں"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F0E4",
          "dark": {
            "backgroundColor": "#F6F0E4"
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/learnwritingchinese/ur"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef2bb36b-416b-4d1d-8d16-73d92c736048"
      }
    },
    "owner": "formone98127"
  }
}
